{
  "manifest_version": 3,
  "name": "Jobify Copilot - 1-Click Autofill, AI Resumes & Job Tracker",
  "short_name": "Jobify",
  "version": "1.0.0",
  "description": "Autofill job applications in 1 click across Workday, Greenhouse, Lever & Ashby, tailor ATS resumes with Gemini AI, check missing keywords, run Autopilot, and track every application.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Jobify Copilot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "dashboard/dashboard.html",
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "alarms",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/ats_adapters.js",
        "content/copilot_widget.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "dashboard/dashboard.html",
        "sandbox/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
